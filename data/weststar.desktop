[Desktop Entry]
Type=Application
Name=Weststar SDL Browser
GenericName=Web Browser
Comment=A small, hand-written web browser on SDL
Exec=weststar -- %U
Icon=weststar
Terminal=false
StartupWMClass=org.weststar.SdlBrowser
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
