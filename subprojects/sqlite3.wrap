[wrap-file]
# SQLite (WrapDB), used where no system SQLite is found, or forced with
# --force-fallback-for=sqlite3 as in the Windows XP build
# (scripts/winxp-i686.ini). SQLite now calls two things Windows XP lacks,
# slim reader/writer locks and GetTickCount64: built for XP,
# sqlite3-winxp.patch makes its mutexes critical sections and takes
# GetTickCount.
directory = sqlite-amalgamation-3540100
source_url = https://www.sqlite.org/2026/sqlite-amalgamation-3540100.zip
source_filename = sqlite-amalgamation-3540100.zip
source_hash = 0a9c8e34352dad46006aa82836d5383bff9dc6bc9ce5a60553c05aa30e6ad1f9
source_fallback_url = https://wrapdb.mesonbuild.com/v2/sqlite3_3.54.1-1/get_source/sqlite-amalgamation-3540100.zip
patch_filename = sqlite3_3.54.1-1_patch.zip
patch_url = https://wrapdb.mesonbuild.com/v2/sqlite3_3.54.1-1/get_patch
patch_fallback_url = https://github.com/mesonbuild/wrapdb/releases/download/sqlite3_3.54.1-1/sqlite3_3.54.1-1_patch.zip
patch_hash = 2164f6f514910ae4c754f6fa467862fb27b594b00126fac51d118112288e1486
wrapdb_version = 3.54.1-1
diff_files = sqlite3-winxp.patch

[provide]
dependency_names = sqlite3
