+#if defined(_WIN32_WINNT) && _WIN32_WINNT < 0x0600
+/* Windows XP has no GetFileInformationByHandleEx: the standard information
+ * from what GetFileInformationByHandle gave, which both callers have in
+ * handle_info (Weststar). */
+static BOOL
+ns_xp_standard_info (const BY_HANDLE_FILE_INFORMATION *h,
+                     FILE_STANDARD_INFO               *s)
+{
+  s->EndOfFile.QuadPart = ((LONGLONG) h->nFileSizeHigh << 32) | h->nFileSizeLow;
+  s->AllocationSize = s->EndOfFile;
+  s->NumberOfLinks = h->nNumberOfLinks;
+  s->DeletePending = FALSE;
+  s->Directory = (h->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+  return TRUE;
+}
+#define GetFileInformationByHandleEx(handle, cls, info, size) \
+  ns_xp_standard_info (&handle_info, (info))
+#endif
