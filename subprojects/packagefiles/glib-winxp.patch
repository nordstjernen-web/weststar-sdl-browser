@@ -604,6 +604,55 @@
 
 #ifdef G_OS_WIN32
 
+#if defined(_WIN32_WINNT) && _WIN32_WINNT < 0x0600
+/* Windows XP has no SHGetKnownFolderPath: it is looked up at run time, and
+ * where it is missing the folder's CSIDL goes to SHGetFolderPathW. Folders
+ * XP does not know (Downloads, Public) are NULL, as for a failure
+ * (Weststar). */
+typedef HRESULT (WINAPI *ns_known_folder_fn) (REFKNOWNFOLDERID, DWORD, HANDLE, PWSTR *);
+
+static gchar *
+get_special_folder (REFKNOWNFOLDERID known_folder_guid_ptr)
+{
+  static const struct { const KNOWNFOLDERID *id; int csidl; } csidls[] = {
+    { &FOLDERID_Profile, CSIDL_PROFILE },
+    { &FOLDERID_LocalAppData, CSIDL_LOCAL_APPDATA },
+    { &FOLDERID_InternetCache, CSIDL_INTERNET_CACHE },
+    { &FOLDERID_Desktop, CSIDL_DESKTOPDIRECTORY },
+    { &FOLDERID_Documents, CSIDL_PERSONAL },
+    { &FOLDERID_Music, CSIDL_MYMUSIC },
+    { &FOLDERID_Pictures, CSIDL_MYPICTURES },
+    { &FOLDERID_PublicDocuments, CSIDL_COMMON_DOCUMENTS },
+    { &FOLDERID_Templates, CSIDL_TEMPLATES },
+    { &FOLDERID_Videos, CSIDL_MYVIDEO },
+    { &FOLDERID_ProgramData, CSIDL_COMMON_APPDATA },
+  };
+  HMODULE shell32 = GetModuleHandleW (L"shell32.dll");
+  ns_known_folder_fn known = shell32
+    ? (ns_known_folder_fn) (void *) GetProcAddress (shell32, "SHGetKnownFolderPath")
+    : NULL;
+  gchar *result = NULL;
+  gsize i;
+
+  if (known)
+    {
+      wchar_t *wcp = NULL;
+      if (SUCCEEDED (known (known_folder_guid_ptr, 0, NULL, &wcp)))
+        result = g_utf16_to_utf8 (wcp, -1, NULL, NULL, NULL);
+      CoTaskMemFree (wcp);
+      return result;
+    }
+  for (i = 0; i < G_N_ELEMENTS (csidls); i++)
+    if (IsEqualGUID (known_folder_guid_ptr, csidls[i].id))
+      {
+        wchar_t path[MAX_PATH];
+        if (SUCCEEDED (SHGetFolderPathW (NULL, csidls[i].csidl, NULL, 0, path)))
+          result = g_utf16_to_utf8 (path, -1, NULL, NULL, NULL);
+        break;
+      }
+  return result;
+}
+#else
 static gchar *
 get_special_folder (REFKNOWNFOLDERID known_folder_guid_ptr)
 {
@@ -620,6 +669,7 @@
 
