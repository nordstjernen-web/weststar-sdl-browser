+/* The waiter count is kept under the mutex the condition is used with,
+   which the callers of js_cond_signal and js_cond_broadcast hold. The
+   semaphore holds one count for each waiter woken and not yet run. */
+static inline void js_cond_init(js_cond_t *cond) {
+    cond->sema = CreateSemaphoreW(NULL, 0, 0x7fffffff, NULL);
+    cond->waiters = 0;
+    if (!cond->sema)
+        abort();
+}
+
+static inline void js_cond_destroy(js_cond_t *cond) {
+    CloseHandle(cond->sema);
+}
+
+static inline void js_cond_signal(js_cond_t *cond) {
+    if (cond->waiters > 0) {
+        cond->waiters--;
+        ReleaseSemaphore(cond->sema, 1, NULL);
+    }
+}
+
+static inline void js_cond_broadcast(js_cond_t *cond) {
+    if (cond->waiters > 0) {
+        LONG n = cond->waiters;
+        cond->waiters = 0;
+        ReleaseSemaphore(cond->sema, n, NULL);
+    }
+}
