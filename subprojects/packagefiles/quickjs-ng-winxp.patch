+static inline void js_once(js_once_t *guard, js__once_cb callback) {
+    /* 0: not run, 1: running, 2: done. */
+    if (InterlockedCompareExchange(&guard->state, 1, 0) == 0) {
+        callback();
+        InterlockedExchange(&guard->state, 2);
+        return;
+    }
+    while (InterlockedCompareExchange(&guard->state, 2, 2) != 2)
+        Sleep(0);
+}
