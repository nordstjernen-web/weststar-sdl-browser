+    if (WaitForSingleObject(cond->sema, 0) == WAIT_OBJECT_0)
+        return 0;
+    cond->waiters--;
+    return -1;
+}
+
+static inline void js_cond_wait(js_cond_t *cond, js_mutex_t *mutex) {
+    js__cond_wait_ms(cond, mutex, INFINITE);
+}
