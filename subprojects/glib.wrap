[wrap-file]
# GLib 2.80, used only by -Dglib=bundled: the part of GLib and GObject the
# browser calls, built statically from this release by
# packagefiles/glib/meson.build instead of taken from the system. See
# docs/porting-to-sdl.md, stage 6.5.
directory = glib-2.80.5
source_url = https://download.gnome.org/sources/glib/2.80/glib-2.80.5.tar.xz
source_filename = glib-2.80.5.tar.xz
source_hash = 9f23a9de803c695bbfde7e37d6626b18b9a83869689dd79019bf3ae66c3e6771
patch_directory = glib

[provide]
glib-2.0 = glib_dep
gobject-2.0 = gobject_dep
