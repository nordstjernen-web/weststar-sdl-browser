option('build_date', type: 'string', value: '',
       description: 'Build date stamp shown in the About dialog (defaults to the configure-time date).')
option('wasm', type: 'feature', value: 'auto',
       description: 'Build the WebAssembly JS API over the vendored WAMR interpreter (on by default on x86-64 and 64-bit Arm, the CPUs its call stubs cover; disable on platforms WAMR does not support, e.g. NetBSD).')
option('avif', type: 'feature', value: 'auto',
       description: 'Decode AVIF images through libavif (on by default when libavif is present). AVIF is a rare format on the web and libavif pulls in a full AV1 decoder; disable to drop it.')
option('sdl', type: 'combo', choices: ['sdl3', 'sdl2'], value: 'sdl3',
       description: 'SDL version: SDL3 (default), or SDL2 for systems that have only SDL2 (Windows XP, the Amiga family): the same browser, with SDL2 under SDL3\'s names (src/plat/ns_sdl.h). Needs SDL 2.0.18 or later: the system\'s if installed, else the release pinned in subprojects/sdl2.wrap, built statically (force that with --force-fallback-for=sdl2).')
option('audio', type: 'feature', value: 'auto',
       description: 'Enable in-process audio playback (SDL output + minimp3/pl_mpeg decode). Disable to build without audio; SDL itself is always required for the window.')
option('js_engine', type: 'combo', choices: ['quickjs-ng', 'quickjs'], value: 'quickjs-ng',
       description: 'JavaScript engine: quickjs-ng (default) or the original QuickJS by Fabrice Bellard, each built from its pinned subproject.')
option('crypto', type: 'combo', choices: ['openssl', 'mbedtls'], value: 'openssl',
       description: 'Library behind Web Crypto, random numbers and hashing: OpenSSL libcrypto (default), or Mbed TLS 3.6 for portable builds without OpenSSL (the system copy if installed, else the release pinned in subprojects/mbedtls.wrap, built statically). The mbedtls build lacks Ed25519 and Ed448, which Web Crypto then refuses with NotSupportedError. HTTPS is unaffected: it goes through libcurl and its own TLS library.')
option('glib', type: 'combo', choices: ['system', 'bundled'], value: 'system',
       description: 'Where GLib and GObject come from: the system (default), or bundled: the part of them the browser uses, built statically from the release pinned in subprojects/glib.wrap, for a browser that needs no GLib installed. Not yet for macOS.')
option('fontconfig', type: 'feature', value: 'auto',
       description: 'Find fonts through the system fontconfig library (auto: when it is installed). Disabled, or where fontconfig is missing, fonts are found by nsfc (src/fc/), built into the browser: it reads the font folders of the platform itself, with FreeType, and needs no configuration files. For portable builds, and platforms without fontconfig.')
option('text', type: 'combo', choices: ['pango', 'native'], value: 'pango',
       description: 'The text layout library. pango (the default): web-text-lib, the in-tree Pango fork (src/web-text-lib/), on GLib and GObject. native: nstext (src/text/), the same API on HarfBuzz, FriBidi and FreeType, with no Pango, GObject or GLib in it; opt-in while it is compared against Pango (docs/text-layout.md).')
option('bundled_fonts', type: 'feature', value: 'auto',
       description: 'Compile a small set of fallback fonts into the browser (DejaVu Sans, Sans Bold, Serif and Sans Mono, about 2.1 MB, fetched from the release pinned in subprojects/dejavu-fonts.wrap), for systems with no font of a kind or none at all. nsfc offers them after the system\'s own fonts. Auto: wherever nsfc is built (fontconfig disabled or missing); with the system fontconfig they are never used, and enabled is then an error.')
option('ca_bundle', type: 'string', value: '',
       description: 'A file of CA certificates in PEM format (such as curl.se/ca/cacert.pem, Mozilla\'s set) to compile into the browser as its own trust store for HTTPS. It is used where the system has no certificate file, and wherever NS_CA_BUNDLE=builtin is set, for systems whose own root certificates are too old. Empty (the default): none is compiled in.')
option('pdfjs', type: 'feature', value: 'auto',
       description: 'Show PDF documents in a viewer built on PDF.js, run as sandboxed script inside the engine and embedded at build time. Auto: built when PDF.js is available. Enabled: required, the build fails without it. Disabled: left out, and a PDF shows a notice with a link to the file. PDF.js comes from pdfjs_dir when that is set, else from the release pinned in subprojects/pdfjs-dist.wrap, which is fetched and never committed.')
option('pdfjs_dir', type: 'string', value: '',
       description: 'Directory of an installed PDF.js to embed instead of the pinned release, such as /usr/share/pdf.js. Both the pdfjs-dist layout (build/pdf.min.mjs, wasm/) and the generic viewer layout (build/pdf.mjs, web/wasm/) are accepted. Must hold PDF.js 6.5 or a later 6.x; anything else fails the build.')
